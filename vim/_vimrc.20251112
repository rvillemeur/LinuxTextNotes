"{{{ groff utilities
au BufWritePost,BufFilePost *.ms !groff -ms % -Tpdf > %:r.pdf
au BufWritePost,BufFilePost *.me !tbl % | groff -me -Tpdf > %:r.pdf
au BufWritePost,BufFilePost *.pic !groff -p % -Tpdf > %:r.pdf

