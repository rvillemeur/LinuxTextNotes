" Ne pas assurer la compatibilité avec l'ancien Vi
set nocompatible

"{{{ vim-plug set-up
" source: https://github.com/junegunn/vim-plug
"if empty(glob('~/.vim/autoload/plug.vim'))
"  silent !curl -fLo ~/.vim/autoload/plug.vim --create-dirs
"    \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
"  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
"endif
call plug#begin('~/.vim/plugged')
"" My Bundles here:
" color theme
Plug 'cocopon/iceberg.vim'
" deal with unicode character
Plug 'chrisbra/unicode.vim'
" powerline-like style for Vim status bar
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'
Plug 'tpope/vim-fugitive' " git plugin for vim
" toggle filesystem explorer
Plug 'scrooloose/nerdtree'
Plug 'tiagofumo/vim-nerdtree-syntax-highlight'
Plug 'Xuyuanp/nerdtree-git-plugin'
"Plug 'mhinz/vim-startify'
Plug 'wuelnerdotexe/nerdterm'   "toggle terminal
" full path fuzzy file, buffer, mru, tag, ... finder for Vim
Plug 'kien/ctrlp.vim'
"Plug 'kshenoy/vim-signature'
Plug 'dpelle/vim-languagetool'
"Emoji management
"Plug 'kyuhi/vim-emoji-complete'
Plug 'junegunn/vim-emoji'       "insert emoji 2
" improve tabular alignment of data
"Plug 'godlygeek/tabular'
" better markdown support
Plug 'preservim/vim-markdown'
Plug 'dhruvasagar/vim-table-mode'
"Plug 'vimwiki/vimwiki'
Plug 'rickhowe/wrapwidth'
"Plug 'tmux-plugins/vim-tmux'
"Plug 'fholgado/minibufexpl.vim'
Plug 'jlanzarotta/bufexplorer'
"Better window managementevicons'
Plug 'Aster89/WinZoZ'
" Distraction free vim
Plug 'junegunn/goyo.vim'
Plug 'junegunn/limelight.vim'
Plug 'kshenoy/vim-signature'    "place, toggle and display marks.
Plug 'gcmt/taboo.vim'           "help renaming vim tabs
Plug 'Aster89/WinZoZ'           "Better window management
Plug 'ryanoasis/vim-devicons'
Plug 'mhinz/vim-signify'        "show difference in git 
Plug 'adelarsq/vim-emoji-icon-theme' "another emoji, test from devicons
Plug 'lambdalisue/vim-glyph-palette' "apply colors on Nerd Fonts.
" All of your Plugins must be added before the following line

call plug#end()            " required

"automatic loading of plugin and indent rule, bases on file type
filetype plugin on
filetype indent on

